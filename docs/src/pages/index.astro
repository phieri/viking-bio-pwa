---
import { supportedLanguages } from '../content/site';
const baseHref = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="mul">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Viking Bio integration for monitoring and managing pellet burner telemetry with a Pico-based bridge and local configurator."
    />
    <link rel="canonical" href={new URL(`${baseHref}en/`, Astro.site || 'https://phieri.github.io').href} />
    <title>Viking Bio Integration</title>
    <link rel="icon" href={`${baseHref}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <noscript>
      <p>
        {supportedLanguages.map(({ code, label }) => (
          <a href={`${baseHref}${code}/`}>{label}</a>
        ))}
      </p>
    </noscript>
    <script define:vars={{ supportedLanguages }}>
      (function () {
        var supported = supportedLanguages;
        var preferredList = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
        function normalise(value) {
          return String(value || '').toLowerCase().replace(/_/g, '-');
        }
        function pickLanguage() {
          for (var i = 0; i < preferredList.length; i += 1) {
            var candidate = normalise(preferredList[i]);
            for (var j = 0; j < supported.length; j += 1) {
              var aliases = supported[j].browserCodes || [];
              for (var k = 0; k < aliases.length; k += 1) {
                if (candidate.indexOf(aliases[k]) === 0) {
                  return supported[j].code;
                }
              }
            }
          }
          return 'en';
        }
        var preferred = pickLanguage();
        window.location.replace(new URL(preferred + '/', document.baseURI).href);
      })();
    </script>
  </body>
</html>
